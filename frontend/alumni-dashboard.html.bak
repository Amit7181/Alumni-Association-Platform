<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Alumni Dashboard - AlumniConnect</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
    <link href="css/style.css" rel="stylesheet">
    <link href="css/dashboard.css" rel="stylesheet">
</head>
<body>

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-custom fixed-top">
        <div class="container-fluid px-4">
            <div class="d-flex align-items-center">
                <button class="btn btn-outline-secondary me-3 d-md-none" id="sidebarToggleBtn">
                    <i class="bi bi-list"></i>
                </button>
                <a class="navbar-brand" href="index.html">
                    <i class="bi bi-mortarboard-fill"></i> AlumniConnect
                </a>
            </div>
            
            <div class="d-flex align-items-center justify-content-end gap-3 flex-grow-1">
                <a href="post-job.html" class="btn btn-sm btn-primary d-none d-md-block">
                    <i class="bi bi-plus-circle"></i> Post Job
                </a>
                <div class="dropdown">
                    <button class="btn p-0 dropdown-toggle d-flex align-items-center" type="button" data-bs-toggle="dropdown">
                        <img src="https://ui-avatars.com/api/?name=Alumni&background=random" class="rounded-circle border" width="40" height="40" alt="User">
                        <span class="ms-2 fw-semibold dashboard-user-name">Alumni</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow border-0">
                        <li><a class="dropdown-item" href="profile-settings.html"><i class="bi bi-person me-2"></i>Profile Settings</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item text-danger" href="#" onclick="api.logout()"><i class="bi bi-box-arrow-right me-2"></i>Logout</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </nav>

    <div class="dashboard-container">
        <!-- Sidebar -->
        <aside class="sidebar d-none d-md-block" id="sidebar">
            <div class="sidebar-nav">
                <a href="#" onclick="switchDashboardSection('overview')" class="sidebar-link active" id="link-overview"><i class="bi bi-grid-1x2"></i> Dashboard</a>
                <a href="#" onclick="switchDashboardSection('directory')" class="sidebar-link" id="link-directory"><i class="bi bi-people"></i> Directory</a>
                <a href="#" onclick="switchDashboardSection('jobs')" class="sidebar-link" id="link-jobs"><i class="bi bi-briefcase"></i> Jobs</a>
                <a href="#" onclick="switchDashboardSection('events')" class="sidebar-link" id="link-events"><i class="bi bi-calendar-event"></i> Events</a>
                <a href="#" onclick="switchDashboardSection('mentorship')" class="sidebar-link" id="link-mentorship"><i class="bi bi-person-up"></i> Mentorship</a>
                <a href="#" onclick="switchDashboardSection('community')" class="sidebar-link" id="link-community"><i class="bi bi-chat-square-text"></i> Community</a>
            </div>
        </aside>

        <!-- Main Content -->
        <main class="main-content">
            <div id="section-overview" class="dashboard-section">
                <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
                    <h3 class="fw-bold mb-0">Alumni Dashboard</h3>
                    <span class="badge bg-success bg-opacity-10 text-success px-3 py-2 rounded-pill">Alumni Account</span>
                </div>

            <div class="alert alert-primary border-0 bg-primary bg-opacity-10 d-flex align-items-center mb-4" role="alert">
                <i class="bi bi-info-circle-fill me-3 fs-4 text-primary"></i>
                <div>
                    <h6 class="fw-bold mb-1 text-primary">Grow the network!</h6>
                    <p class="mb-0 small text-dark">Help juniors by posting internships or accepting mentorship requests.</p>
                </div>
            </div>

            <!-- SECTION: DIRECTORY -->
            <div id="section-directory" class="dashboard-section d-none">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h3 class="fw-bold mb-0">Alumni Directory</h3>
                </div>
                <div class="card shadow-sm border-0 mb-4 p-3">
                    <form id="directoryFilterForm" class="row g-3">
                        <div class="col-md-4"><input type="text" id="dirSearch" class="form-control" placeholder="Search by name, company..."></div>
                        <div class="col-md-3"><input type="text" id="dirLocation" class="form-control" placeholder="Location"></div>
                        <div class="col-md-3">
                            <select id="dirSkill" class="form-select">
                                <option value="">Specialization</option>
                                <option value="Frontend">Frontend</option>
                                <option value="Backend">Backend</option>
                                <option value="Design">Design</option>
                                <option value="Product">Product</option>
                            </select>
                        </div>
                        <div class="col-md-2"><button type="submit" class="btn btn-primary w-100">Filter</button></div>
                    </form>
                </div>
                <div id="directoryContainer" class="row g-4"><div class="text-center py-5"><div class="spinner-border text-primary"></div></div></div>
            </div>

            <!-- SECTION: JOBS -->
            <div id="section-jobs" class="dashboard-section d-none">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h3 class="fw-bold mb-0">Job Board</h3>
                    <div id="alumniPostJobBtn" class="d-flex">
                        <a href="post-job.html" class="btn btn-primary rounded-pill"><i class="bi bi-plus-circle me-2"></i>Post a Job</a>
                    </div>
                </div>
                <div class="row g-4">
                    <div class="col-lg-3">
                        <div class="filter-sidebar bg-white shadow-sm rounded p-4 h-100">
                            <h5>Filters</h5>
                            <form id="dashJobFilterForm">
                                <div class="mb-3">
                                    <label class="form-label small fw-semibold">Keywords</label>
                                    <input type="text" id="dashJobSearch" class="form-control form-control-sm" placeholder="e.g. Developer">
                                </div>
                                <div class="mb-3">
                                    <label class="form-label small fw-semibold">Job Type</label>
                                    <select id="dashJobType" class="form-select form-select-sm">
                                        <option value="">All Types</option>
                                        <option value="job">Full-time Job</option>
                                        <option value="internship">Internship</option>
                                    </select>
                                </div>
                                <div class="mb-4">
                                    <label class="form-label small fw-semibold">Location</label>
                                    <input type="text" id="dashJobLocation" class="form-control form-control-sm" placeholder="e.g. Remote">
                                </div>
                                <button type="submit" class="btn btn-primary w-100 btn-sm">Find Jobs</button>
                            </form>
                        </div>
                    </div>
                    <div class="col-lg-9">
                        <div id="dashJobsContainer"><div class="text-center py-5"><div class="spinner-border text-primary"></div></div></div>
                    </div>
                </div>
            </div>

            <!-- SECTION: EVENTS -->
            <div id="section-events" class="dashboard-section d-none">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h3 class="fw-bold mb-0">Upcoming Events</h3>
                </div>
                <div class="row g-4">
                    <div class="col-lg-3">
                        <div class="filter-sidebar bg-white shadow-sm rounded p-4 h-100">
                            <h5>Categories</h5>
                            <div class="list-group list-group-flush" id="eventCategories">
                                <button class="list-group-item list-group-item-action border-0 active" onclick="filterEventsByCategory('All')">All Events</button>
                                <button class="list-group-item list-group-item-action border-0" onclick="filterEventsByCategory('Webinar')">Webinars</button>
                                <button class="list-group-item list-group-item-action border-0" onclick="filterEventsByCategory('Workshop')">Workshops</button>
                                <button class="list-group-item list-group-item-action border-0" onclick="filterEventsByCategory('Meetup')">Meetups</button>
                                <button class="list-group-item list-group-item-action border-0" onclick="filterEventsByCategory('Hackathon')">Hackathons</button>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-9">
                        <div id="dashEventsContainer" class="row g-4"><div class="text-center py-5"><div class="spinner-border text-warning"></div></div></div>
                    </div>
                </div>
            </div>

            <!-- SECTION: MENTORSHIP -->
            <div id="section-mentorship" class="dashboard-section d-none">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h3 class="fw-bold mb-0">Mentorship Requests</h3>
                </div>
                <div id="mentorshipContainer" class="row g-4"><div class="text-center py-5"><div class="spinner-border text-primary"></div></div></div>
            </div>

            <!-- SECTION: COMMUNITY -->
            <div id="section-community" class="dashboard-section d-none">
                <div class="row justify-content-center">
                    <div class="col-lg-8">
                        <!-- Post Composer -->
                        <div class="card shadow-sm border-0 mb-4">
                            <div class="card-body">
                                <form id="dashPostForm">
                                    <div class="d-flex mb-3">
                                        <img src="https://ui-avatars.com/api/?name=User&background=random" class="rounded-circle me-3 dashboard-user-avatar" width="50" height="50">
                                        <textarea class="form-control border-0 bg-light" id="dashPostContent" rows="3" placeholder="Share something with the community..." required></textarea>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center">
                                        <select class="form-select form-select-sm border-0 bg-light rounded-pill ms-2" id="dashPostType" style="width: auto;">
                                            <option value="general">Updates</option>
                                            <option value="success_story">Success Story</option>
                                            <option value="job_update">Job Referral</option>
                                        </select>
                                        <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold" id="dashPostBtn">Post</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                        <!-- Feed -->
                        <div id="dashCommunityFeed"><div class="text-center py-5"><div class="spinner-border text-primary"></div></div></div>
                    </div>
            <!-- Summary Cards -->
            <div class="row g-4 mb-4">
                    <div class="col-md-6 col-lg-3">
                        <div class="summary-card">
                            <div class="summary-icon bg-success-light">
                                <i class="bi bi-briefcase-fill"></i>
                            </div>
                            <div>
                                <h3 class="fw-bold mb-0" id="stat-my-jobs">0</h3>
                                <p class="text-muted mb-0 small">Jobs Posted</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 col-lg-3">
                        <div class="summary-card">
                            <div class="summary-icon bg-warning-light">
                                <i class="bi bi-calendar-event-fill"></i>
                            </div>
                            <div>
                                <h3 class="fw-bold mb-0" id="stat-my-events">0</h3>
                                <p class="text-muted mb-0 small">Events Hosted</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 col-lg-3">
                        <div class="summary-card">
                            <div class="summary-icon bg-danger-light">
                                <i class="bi bi-person-check-fill"></i>
                            </div>
                            <div>
                                <h3 class="fw-bold mb-0" id="stat-my-mentees">0</h3>
                                <p class="text-muted mb-0 small">Active Mentees</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 col-lg-3">
                        <div class="summary-card border-0 shadow-sm p-4 h-100">
                            <div class="d-flex align-items-center mb-3">
                                <div class="bg-info-light p-2 rounded me-3"><i class="bi bi-chat-dots-fill text-info h4 mb-0"></i></div>
                                <div><h3 class="mb-0 fw-bold" id="stat-my-posts">0</h3><small class="text-muted">Community Posts</small></div>
                            </div>
                        </div>
                    </div></div>
                    </div>
                </div>
            </div>

            <!-- SECTION: DIRECTORY -->
            <div id="section-directory" class="dashboard-section d-none">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h3 class="fw-bold mb-0">Alumni Directory</h3>
                </div>
                <div class="card shadow-sm border-0 mb-4 p-3">
                    <form id="directoryFilterForm" class="row g-3">
                        <div class="col-md-4"><input type="text" id="dirSearch" class="form-control" placeholder="Search by name, company..."></div>
                        <div class="col-md-3"><input type="text" id="dirLocation" class="form-control" placeholder="Location"></div>
                        <div class="col-md-3">
                            <select id="dirSkill" class="form-select">
                                <option value="">Specialization</option>
                                <option value="Frontend">Frontend</option>
                                <option value="Backend">Backend</option>
                                <option value="Design">Design</option>
                                <option value="Product">Product</option>
                            </select>
                        </div>
                        <div class="col-md-2"><button type="submit" class="btn btn-primary w-100">Filter</button></div>
                    </form>
                </div>
                <div id="directoryContainer" class="row g-4"><div class="text-center py-5"><div class="spinner-border text-primary"></div></div></div>
            </div>

            <!-- SECTION: JOBS -->
            <div id="section-jobs" class="dashboard-section d-none">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h3 class="fw-bold mb-0">Job Board</h3>
                    <div id="alumniPostJobBtn" class="d-flex">
                        <a href="post-job.html" class="btn btn-primary rounded-pill"><i class="bi bi-plus-circle me-2"></i>Post a Job</a>
                    </div>
                </div>
                <div class="row g-4">
                    <div class="col-lg-3">
                        <div class="filter-sidebar bg-white shadow-sm rounded p-4 h-100">
                            <h5>Filters</h5>
                            <form id="dashJobFilterForm">
                                <div class="mb-3">
                                    <label class="form-label small fw-semibold">Keywords</label>
                                    <input type="text" id="dashJobSearch" class="form-control form-control-sm" placeholder="e.g. Developer">
                                </div>
                                <div class="mb-3">
                                    <label class="form-label small fw-semibold">Job Type</label>
                                    <select id="dashJobType" class="form-select form-select-sm">
                                        <option value="">All Types</option>
                                        <option value="job">Full-time Job</option>
                                        <option value="internship">Internship</option>
                                    </select>
                                </div>
                                <div class="mb-4">
                                    <label class="form-label small fw-semibold">Location</label>
                                    <input type="text" id="dashJobLocation" class="form-control form-control-sm" placeholder="e.g. Remote">
                                </div>
                                <button type="submit" class="btn btn-primary w-100 btn-sm">Find Jobs</button>
                            </form>
                        </div>
                    </div>
                    <div class="col-lg-9">
                        <div id="dashJobsContainer"><div class="text-center py-5"><div class="spinner-border text-primary"></div></div></div>
                    </div>
                </div>
            </div>

            <!-- SECTION: EVENTS -->
            <div id="section-events" class="dashboard-section d-none">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h3 class="fw-bold mb-0">Upcoming Events</h3>
                </div>
                <div class="row g-4">
                    <div class="col-lg-3">
                        <div class="filter-sidebar bg-white shadow-sm rounded p-4 h-100">
                            <h5>Categories</h5>
                            <div class="list-group list-group-flush" id="eventCategories">
                                <button class="list-group-item list-group-item-action border-0 active" onclick="filterEventsByCategory('All')">All Events</button>
                                <button class="list-group-item list-group-item-action border-0" onclick="filterEventsByCategory('Webinar')">Webinars</button>
                                <button class="list-group-item list-group-item-action border-0" onclick="filterEventsByCategory('Workshop')">Workshops</button>
                                <button class="list-group-item list-group-item-action border-0" onclick="filterEventsByCategory('Meetup')">Meetups</button>
                                <button class="list-group-item list-group-item-action border-0" onclick="filterEventsByCategory('Hackathon')">Hackathons</button>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-9">
                        <div id="dashEventsContainer" class="row g-4"><div class="text-center py-5"><div class="spinner-border text-warning"></div></div></div>
                    </div>
                </div>
            </div>

            <!-- SECTION: MENTORSHIP -->
            <div id="section-mentorship" class="dashboard-section d-none">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h3 class="fw-bold mb-0">Mentorship Requests</h3>
                </div>
                <div id="mentorshipContainer" class="row g-4"><div class="text-center py-5"><div class="spinner-border text-primary"></div></div></div>
            </div>

            <!-- SECTION: COMMUNITY -->
            <div id="section-community" class="dashboard-section d-none">
                <div class="row justify-content-center">
                    <div class="col-lg-8">
                        <!-- Post Composer -->
                        <div class="card shadow-sm border-0 mb-4">
                            <div class="card-body">
                                <form id="dashPostForm">
                                    <div class="d-flex mb-3">
                                        <img src="https://ui-avatars.com/api/?name=User&background=random" class="rounded-circle me-3 dashboard-user-avatar" width="50" height="50">
                                        <textarea class="form-control border-0 bg-light" id="dashPostContent" rows="3" placeholder="Share something with the community..." required></textarea>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center">
                                        <select class="form-select form-select-sm border-0 bg-light rounded-pill ms-2" id="dashPostType" style="width: auto;">
                                            <option value="general">Updates</option>
                                            <option value="success_story">Success Story</option>
                                            <option value="job_update">Job Referral</option>
                                        </select>
                                        <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold" id="dashPostBtn">Post</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                        <!-- Feed -->
                        <div id="dashCommunityFeed"><div class="text-center py-5"><div class="spinner-border text-primary"></div></div></div>
                    </div>
                </div>
            </div>

            <div class="row g-4">
                <!-- Mentorship Requests -->
                <div class="col-lg-6">
                    <div class="card h-100">
                        <div class="card-header bg-white py-3">
                            <h5 class="mb-0 fw-bold"><i class="bi bi-inbox text-primary me-2"></i> Recent Mentorship Requests</h5>
                        </div>
                        <div class="card-body" id="recentMentorshipsContainer">
                            <div class="text-center py-4">
                                <div class="spinner-border text-primary" role="status"></div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Recent Events -->
                <div class="col-lg-6">
                    <div class="card h-100">
                        <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
                            <h5 class="mb-0 fw-bold"><i class="bi bi-calendar-event text-warning me-2"></i> Upcoming Events</h5>
                            <button onclick="switchDashboardSection('events')" class="btn btn-sm btn-outline-primary">View All</button>
                        </div>
                        <div class="card-body" id="recentEventsContainer">
                            <div class="text-center py-4">
                                <div class="spinner-border text-primary" role="status"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- SECTION: DIRECTORY -->
            <div id="section-directory" class="dashboard-section d-none">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h3 class="fw-bold mb-0">Alumni Directory</h3>
                </div>
                <div class="card shadow-sm border-0 mb-4 p-3">
                    <form id="directoryFilterForm" class="row g-3">
                        <div class="col-md-4"><input type="text" id="dirSearch" class="form-control" placeholder="Search by name, company..."></div>
                        <div class="col-md-3"><input type="text" id="dirLocation" class="form-control" placeholder="Location"></div>
                        <div class="col-md-3">
                            <select id="dirSkill" class="form-select">
                                <option value="">Specialization</option>
                                <option value="Frontend">Frontend</option>
                                <option value="Backend">Backend</option>
                                <option value="Design">Design</option>
                                <option value="Product">Product</option>
                            </select>
                        </div>
                        <div class="col-md-2"><button type="submit" class="btn btn-primary w-100">Filter</button></div>
                    </form>
                </div>
                <div id="directoryContainer" class="row g-4"><div class="text-center py-5"><div class="spinner-border text-primary"></div></div></div>
            </div>

            <!-- SECTION: JOBS -->
            <div id="section-jobs" class="dashboard-section d-none">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h3 class="fw-bold mb-0">Job Board</h3>
                    <div id="alumniPostJobBtn" class="d-flex">
                        <a href="post-job.html" class="btn btn-primary rounded-pill"><i class="bi bi-plus-circle me-2"></i>Post a Job</a>
                    </div>
                </div>
                <div class="row g-4">
                    <div class="col-lg-3">
                        <div class="filter-sidebar bg-white shadow-sm rounded p-4 h-100">
                            <h5>Filters</h5>
                            <form id="dashJobFilterForm">
                                <div class="mb-3">
                                    <label class="form-label small fw-semibold">Keywords</label>
                                    <input type="text" id="dashJobSearch" class="form-control form-control-sm" placeholder="e.g. Developer">
                                </div>
                                <div class="mb-3">
                                    <label class="form-label small fw-semibold">Job Type</label>
                                    <select id="dashJobType" class="form-select form-select-sm">
                                        <option value="">All Types</option>
                                        <option value="job">Full-time Job</option>
                                        <option value="internship">Internship</option>
                                    </select>
                                </div>
                                <div class="mb-4">
                                    <label class="form-label small fw-semibold">Location</label>
                                    <input type="text" id="dashJobLocation" class="form-control form-control-sm" placeholder="e.g. Remote">
                                </div>
                                <button type="submit" class="btn btn-primary w-100 btn-sm">Find Jobs</button>
                            </form>
                        </div>
                    </div>
                    <div class="col-lg-9">
                        <div id="dashJobsContainer"><div class="text-center py-5"><div class="spinner-border text-primary"></div></div></div>
                    </div>
                </div>
            </div>

            <!-- SECTION: EVENTS -->
            <div id="section-events" class="dashboard-section d-none">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h3 class="fw-bold mb-0">Upcoming Events</h3>
                </div>
                <div class="row g-4">
                    <div class="col-lg-3">
                        <div class="filter-sidebar bg-white shadow-sm rounded p-4 h-100">
                            <h5>Categories</h5>
                            <div class="list-group list-group-flush" id="eventCategories">
                                <button class="list-group-item list-group-item-action border-0 active" onclick="filterEventsByCategory('All')">All Events</button>
                                <button class="list-group-item list-group-item-action border-0" onclick="filterEventsByCategory('Webinar')">Webinars</button>
                                <button class="list-group-item list-group-item-action border-0" onclick="filterEventsByCategory('Workshop')">Workshops</button>
                                <button class="list-group-item list-group-item-action border-0" onclick="filterEventsByCategory('Meetup')">Meetups</button>
                                <button class="list-group-item list-group-item-action border-0" onclick="filterEventsByCategory('Hackathon')">Hackathons</button>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-9">
                        <div id="dashEventsContainer" class="row g-4"><div class="text-center py-5"><div class="spinner-border text-warning"></div></div></div>
                    </div>
                </div>
            </div>

            <!-- SECTION: MENTORSHIP -->
            <div id="section-mentorship" class="dashboard-section d-none">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h3 class="fw-bold mb-0">Mentorship Requests</h3>
                </div>
                <div id="mentorshipContainer" class="row g-4"><div class="text-center py-5"><div class="spinner-border text-primary"></div></div></div>
            </div>

            <!-- SECTION: COMMUNITY -->
            <div id="section-community" class="dashboard-section d-none">
                <div class="row justify-content-center">
                    <div class="col-lg-8">
                        <!-- Post Composer -->
                        <div class="card shadow-sm border-0 mb-4">
                            <div class="card-body">
                                <form id="dashPostForm">
                                    <div class="d-flex mb-3">
                                        <img src="https://ui-avatars.com/api/?name=User&background=random" class="rounded-circle me-3 dashboard-user-avatar" width="50" height="50">
                                        <textarea class="form-control border-0 bg-light" id="dashPostContent" rows="3" placeholder="Share something with the community..." required></textarea>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center">
                                        <select class="form-select form-select-sm border-0 bg-light rounded-pill ms-2" id="dashPostType" style="width: auto;">
                                            <option value="general">Updates</option>
                                            <option value="success_story">Success Story</option>
                                            <option value="job_update">Job Referral</option>
                                        </select>
                                        <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold" id="dashPostBtn">Post</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                        <!-- Feed -->
                        <div id="dashCommunityFeed"><div class="text-center py-5"><div class="spinner-border text-primary"></div></div></div>
                    </div>
                </div>
            </div>
            
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="http://localhost:5000/socket.io/socket.io.js"></script>
    <script src="js/api.js"></script>
    <script src="js/main.js"></script>
    <script src="js/dashboard.js"></script>
</body>
</html>
